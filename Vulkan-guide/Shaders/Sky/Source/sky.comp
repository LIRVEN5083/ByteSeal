#version 460

layout (local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D image;

layout(push_constant) uniform constants
{
	vec4 data1;
	vec4 data2;
	vec4 data3;
	vec4 data4;
} PushConstants;

// Исходный алгоритм взят из Shadertoy: "Akiyoshi - Atmospheric Scattering"

#define ATMOSPHERE_SHADERS

const float clouds_height = 1500.0;
const float clouds_scatt = 0.003;
const float earth_radius = 6360000.0; // м
const float atmosphere_radius = 6420000.0; // м

const vec3 betaR = vec3(5.8e-6, 13.5e-6, 33.1e-6);
const vec3 betaM = vec3(21e-6);

const float hR = 8000.0;
const float hM = 1200.0;

bool get_sun_ray_intersection(vec3 ray_origin, vec3 ray_direction, float radius, out float t0, out float t1) {
    vec3 l = vec3(0.0) - ray_origin;
    float dt = dot(l, ray_direction);
    float l2 = dot(l, l);
    float r2 = radius * radius;
    if (dt < 0.0 && l2 > r2) return false;
    float m2 = l2 - dt * dt;
    if (m2 > r2) return false;
    float q = sqrt(r2 - m2);
    t0 = dt - q;
    t1 = dt + q;
    return true;
}

vec4 get_sky_color(vec3 ray_origin, vec3 ray_direction, vec3 sun_direction) {
    float t0, t1;
    if (!get_sun_ray_intersection(ray_origin, ray_direction, atmosphere_radius, t0, t1) || t1 < 0.0) {
        return vec4(0.0);
    }

    t0 = max(t0, 0.0);
    t1 = min(t1, 100000.0); 

    int segments = 16;
    float segment_length = (t1 - t0) / float(segments);
    float current_time = t0;

    vec3 sumR = vec3(0.0);
    vec3 sumM = vec3(0.0);

    float optical_depthR = 0.0;
    float optical_depthM = 0.0;

    float mu = dot(ray_direction, sun_direction);
    float phaseR = 3.0 / (16.0 * 3.1415926535) * (1.0 + mu * mu);
    float g = 0.76;
    float phaseM = 3.0 / (8.0 * 3.1415926535) * ((1.0 - g * g) * (1.0 + mu * mu)) / ((2.0 + g * g) * pow(1.0 + g * g - 2.0 * g * mu, 1.5));

    for (int i = 0; i < segments; ++i) {
        vec3 sample_position = ray_origin + (current_time + segment_length * 0.5) * ray_direction;
        float height = length(sample_position) - earth_radius;

        float hr = exp(-height / hR) * segment_length;
        float hm = exp(-height / hM) * segment_length;

        optical_depthR += hr;
        optical_depthM += hm;

        float t0_light, t1_light;
        if (get_sun_ray_intersection(sample_position, sun_direction, atmosphere_radius, t0_light, t1_light) && t1_light > 0.0) {
            float hr_light = 0.0;
            float hm_light = 0.0;
            int light_segments = 8;
            float light_segment_length = t1_light / float(light_segments);
            float light_time = 0.0;

            for (int j = 0; j < light_segments; ++j) {
                vec3 light_sample_pos = sample_position + (light_time + light_segment_length * 0.5) * sun_direction;
                float light_height = length(light_sample_pos) - earth_radius;
                hr_light += exp(-light_height / hR) * light_segment_length;
                hm_light += exp(-light_height / hM) * light_segment_length;
                light_time += light_segment_length;
            }

            vec3 attenuation = exp(-betaR * (optical_depthR + hr_light) - betaM * (optical_depthM + hm_light));
            sumR += hr * attenuation;
            sumM += hm * attenuation;
        }
        current_time += segment_length;
    }

    vec3 intensity = sumR * betaR * phaseR + sumM * betaM * phaseM;
    return vec4(intensity * 20.0, 1.0);
}

void main() 
{
	ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(image);

	if(texelCoord.x < size.x && texelCoord.y < size.y)
	{
		vec2 uv = vec2(texelCoord) / vec2(size.x, size.y);
		uv = uv * 2.0 - 1.0;

		// Берём направление солнца из первой пуш-константы
		vec3 sun_dir = normalize(PushConstants.data1.xyz);
		
		vec3 ray_origin = vec3(0.0, earth_radius + 1.0, 0.0);
		vec3 ray_direction = normalize(vec3(uv.x, uv.y, 1.5)); 

		vec4 skyColor = get_sky_color(ray_origin, ray_direction, sun_dir);
		
		skyColor.rgb = pow(skyColor.rgb, vec3(1.0 / 2.2)); // Гамма-коррекция

		imageStore(image, texelCoord, skyColor);
	}
}