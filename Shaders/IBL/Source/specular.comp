#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 2) uniform sampler2D skyPanoramaTex;
layout(set = 1, binding = 3, rgba16f) uniform writeonly imageCube iblStorageMaps[];

layout(push_constant) uniform PushConstants {
    mat4 render_matrix;
    uvec2 vertexBuffer;  
    uint colorTextureID; 
    uint metallicRoughnessTextureID;
    uint normalTextureID;
    uint occlusionTextureID;
    vec2 padding;
    vec4 baseColorFactor;
    vec4 materialFactors; // В materialFactors.x лежит roughness (от 0.0 до 1.0)
};

const float PI = 3.14159265359;

vec3 GetCubeDirection(vec2 uv, uint face) {
    vec3 dir = vec3(0.0);
    switch(face) {
        case 0: dir = vec3( 1.0,  uv.y, -uv.x); break; 
        case 1: dir = vec3(-1.0,  uv.y,  uv.x); break; 
        case 2: dir = vec3( uv.x,  1.0, -uv.y); break; 
        case 3: dir = vec3( uv.x, -1.0,  uv.y); break; 
        case 4: dir = vec3( uv.x,  uv.y,  1.0); break; 
        case 5: dir = vec3(-uv.x,  uv.y, -1.0); break; 
    }
    return normalize(dir);
}

// Идеальная функция проецирования панорамы
vec2 SampleSphericalMap(vec3 v) {
    vec2 uv = vec2(atan(v.z, v.x), asin(v.y));
    uv *= vec2(0.15915494, 0.31830988);
    uv += 0.5;
    return uv;
}

float RadicalInverse_VdC(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10; 
}

vec2 Hammersley(uint i, uint N) {
    return vec2(float(i)/float(N), RadicalInverse_VdC(i));
}

// Распределение GGX (NDF)
float DistributionGGX(vec3 N, vec3 H, float roughness) {
    float a = roughness*roughness;
    float a2 = a*a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH*NdotH;
    float nom   = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;
    return nom / max(denom, 0.0001);
}

vec3 ImportanceSampleGGX(vec2 Xi, vec3 N, float roughness) {
    float a = max(roughness * roughness, 0.001);
    
    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a*a - 1.0) * Xi.y));
    cosTheta = clamp(cosTheta, 0.0, 1.0);
    float sinTheta = sqrt(max(1.0 - cosTheta*cosTheta, 0.0));
    
    vec3 H;
    H.x = cos(phi) * sinTheta;
    H.y = sin(phi) * sinTheta;
    H.z = cosTheta;
    
    vec3 up        = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 right     = normalize(cross(up, N));
    up            = cross(N, right);
    
    vec3 sampleVec = H.x * right + H.y * up + H.z * N;
    return normalize(sampleVec);
}

void main() {
    ivec3 cubeCoord = ivec3(gl_GlobalInvocationID);
    ivec2 size = imageSize(iblStorageMaps[colorTextureID]); 
    if (cubeCoord.x >= size.x || cubeCoord.y >= size.y) return;

    vec2 uv = (vec2(cubeCoord.xy) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec3 N = GetCubeDirection(uv, cubeCoord.z);
    vec3 V = N;

    float roughness = max(materialFactors.x, 0.001);

    const uint SAMPLE_COUNT = 512u;
    float totalWeight = 0.0;
    vec3 prefilteredColor = vec3(0.0);
    
    float maxPanoramaMip = float(textureQueryLevels(skyPanoramaTex) - 1);
    if(maxPanoramaMip < 1.0) maxPanoramaMip = 4.0;

    float fixedLod = roughness * maxPanoramaMip + 1.2;

    for(uint i = 0; i < SAMPLE_COUNT; ++i) {
        vec2 Xi = Hammersley(i, SAMPLE_COUNT);
        vec3 H  = ImportanceSampleGGX(Xi, N, roughness);
        vec3 L  = normalize(2.0 * dot(V, H) * H - V); 

        float NdotL = max(dot(N, L), 0.0);
        if(NdotL > 0.0) {
            vec2 texUV = SampleSphericalMap(L);
            
            vec3 sampledColor = textureLod(skyPanoramaTex, texUV, fixedLod).rgb;
            
            if(!any(isnan(sampledColor)) && !any(isinf(sampledColor))) {
                float maxIntensity = 8.0;
                float currentIntensity = max(sampledColor.r, max(sampledColor.g, sampledColor.b));
                if (currentIntensity > maxIntensity) {
                    sampledColor *= (maxIntensity / currentIntensity);
                }

                prefilteredColor += sampledColor * NdotL;
                totalWeight      += NdotL;
            }
        }
    }
    
    if (totalWeight > 0.0) {
        prefilteredColor = prefilteredColor / totalWeight;
    } else {
        prefilteredColor = textureLod(skyPanoramaTex, SampleSphericalMap(N), fixedLod).rgb;
    }

    if(any(isnan(prefilteredColor)) || any(isinf(prefilteredColor))) {
        prefilteredColor = vec3(0.0);
    }

    imageStore(iblStorageMaps[colorTextureID], cubeCoord, vec4(prefilteredColor, 1.0));
}

