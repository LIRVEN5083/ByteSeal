#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 1, binding = 4, rgba16f) uniform image2D globalScreenImages[];

const uint CURRENT_COLOR_IDX = 0;
const uint DEPTH_IDX = 1;
const uint VELOCITY_IDX = 2;
const uint NORMAL_IDX = 3;
const uint HISTORY_0_IDX = 4;
const uint HISTORY_1_IDX = 5;

layout(push_constant) uniform Constants {
    uint frameIndex;
    float screenWidth; 
    float screenHeight;
} pc;

vec3 RGBtoYCoCg(vec3 rgb) { 
    float Y = 0.25 * rgb.r + 0.5 * rgb.g + 0.25 * rgb.b;
    float Co = 0.5 * rgb.r - 0.5 * rgb.b;
    float Cg = -0.25 * rgb.r + 0.5 * rgb.g - 0.25 * rgb.b;
    return vec3(Y, Co, Cg);
}

vec3 YCoCgtoRGB(vec3 ycocg) { 
    float Y = ycocg.x;
    float Co = ycocg.y; 
    float Cg = ycocg.z; 
    float r = Y + Co - Cg;
    float g = Y + Cg;
    float b = Y - Co - Cg;
    return vec3(r, g, b);
}

vec4 sampleImageBilinear(uint imageIdx, vec2 uv) {
    vec2 size = vec2(pc.screenWidth, pc.screenHeight);
    vec2 texelPos = uv * size - 0.5;
    vec2 f = fract(texelPos);
    ivec2 topLeft = ivec2(floor(texelPos));
    ivec2 maxCoord = ivec2(size) - 1;
    
    ivec2 c00 = clamp(topLeft + ivec2(0, 0), ivec2(0), maxCoord);
    ivec2 c10 = clamp(topLeft + ivec2(1, 0), ivec2(0), maxCoord);
    ivec2 c01 = clamp(topLeft + ivec2(0, 1), ivec2(0), maxCoord);
    ivec2 c11 = clamp(topLeft + ivec2(1, 1), ivec2(0), maxCoord);
    
    vec4 t00 = imageLoad(globalScreenImages[nonuniformEXT(imageIdx)], c00);
    vec4 t10 = imageLoad(globalScreenImages[nonuniformEXT(imageIdx)], c10);
    vec4 t01 = imageLoad(globalScreenImages[nonuniformEXT(imageIdx)], c01);
    vec4 t11 = imageLoad(globalScreenImages[nonuniformEXT(imageIdx)], c11);
    
    return mix(mix(t00, t10, f.x), mix(t01, t11, f.x), f.y);
}

vec3 ToneMap(vec3 color) {
    return color / (max(max(color.r, color.g), color.b) + 1.0);
}

vec3 ToneMapInvert(vec3 color) {
    return color / max(0.0001, 1.0 - max(max(color.r, color.g), color.b));
}

bool isCorrupted(vec3 c) {
    return isnan(c.x) || isnan(c.y) || isnan(c.z) || isinf(c.x) || isinf(c.y) || isinf(c.z);
}

vec3 ClipToAABB(vec3 history, vec3 boxMin, vec3 boxMax, vec3 mu) {
    vec3 r = history - mu;
    vec3 minD = (boxMin - mu) / (r + 0.00001);
    vec3 maxD = (boxMax - mu) / (r + 0.00001);
    vec3 maxDCorrected = max(minD, maxD);
    float t = clamp(min(min(maxDCorrected.x, maxDCorrected.y), maxDCorrected.z), 0.0, 1.0);
    return mu + r * t;
}


void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenSize = ivec2(pc.screenWidth, pc.screenHeight);
    if (texelCoord.x >= screenSize.x || texelCoord.y >= screenSize.y) { return; } 
    
    vec2 invScreenSize = 1.0 / vec2(screenSize);
    vec2 uv = (vec2(texelCoord) + 0.5) * invScreenSize;
    
    vec4 currentRGB = imageLoad(globalScreenImages[nonuniformEXT(CURRENT_COLOR_IDX)], texelCoord);
    if (isCorrupted(currentRGB.rgb)) { currentRGB.rgb = vec3(0.0); }

    vec2 velocity = imageLoad(globalScreenImages[nonuniformEXT(VELOCITY_IDX)], texelCoord).xy;
    vec2 historyUV = uv - velocity;
    
    vec3 m1 = vec3(0.0); vec3 m2 = vec3(0.0);
    float totalWeight = 0.0;
    
    float kernel[3] = float[](0.25, 0.5, 0.25); // Гаусс 1D
    
    vec3 boxMin = vec3(10000.0);
    vec3 boxMax = vec3(-10000.0);

    for(int x = -1; x <= 1; ++x) { 
        for(int y = -1; y <= 1; ++y) { 
            ivec2 neighborCoord = clamp(texelCoord + ivec2(x, y), ivec2(0), screenSize - 1);
            vec3 neighborRGB = imageLoad(globalScreenImages[nonuniformEXT(CURRENT_COLOR_IDX)], neighborCoord).rgb;
            if (isCorrupted(neighborRGB)) { neighborRGB = currentRGB.rgb; }
            
            vec3 neighborYCoCg = RGBtoYCoCg(ToneMap(neighborRGB)); 

            float w = kernel[x + 1] * kernel[y + 1];
            
            m1 += neighborYCoCg * w; 
            m2 += (neighborYCoCg * neighborYCoCg) * w; 
            totalWeight += w; 
            
            boxMin = min(boxMin, neighborYCoCg);
            boxMax = max(boxMax, neighborYCoCg);
        } 
    } 

    vec3 mu = m1 / totalWeight;
    vec3 sigma = sqrt(max(vec3(0.00001), (m2 / totalWeight) - (mu * mu)));
    
    float gamma = 1.75; 
    vec3 colorMin = mu - gamma * sigma;
    vec3 colorMax = mu + gamma * sigma; 
    
    colorMin = min(colorMin, boxMin);
    colorMax = max(colorMax, boxMax);
    
    uint currentHistoryIdx = (pc.frameIndex % 2 == 0) ? HISTORY_0_IDX : HISTORY_1_IDX;
    uint writeHistoryIdx = (pc.frameIndex % 2 == 0) ? HISTORY_1_IDX : HISTORY_0_IDX;
    
    vec4 historyRGB = sampleImageBilinear(currentHistoryIdx, historyUV); 
    if (isCorrupted(historyRGB.rgb)) { historyRGB.rgb = currentRGB.rgb; }

    vec3 historyYCoCg = RGBtoYCoCg(ToneMap(historyRGB.rgb));

    historyYCoCg = ClipToAABB(historyYCoCg, colorMin, colorMax, mu);
    vec3 clearedHistoryRGB = ToneMapInvert(YCoCgtoRGB(historyYCoCg));
    
    float speed = length(velocity * vec2(pc.screenWidth, pc.screenHeight));
    
    vec2 toCenter = uv - vec2(0.5);
    float radialComponent = abs(dot(normalize(velocity + vec2(0.00001)), normalize(toCenter + vec2(0.00001))));

    float forwardBackBias = mix(1.0, 0.3, radialComponent * clamp(speed / 5.0, 0.0, 1.0));

    float feedback = mix(0.97, 0.15, clamp(speed / 12.0, 0.0, 1.0)) * forwardBackBias;
    
    if (historyUV.x < 0.0 || historyUV.x > 1.0 || historyUV.y < 0.0 || historyUV.y > 1.0) { 
        feedback = 0.0; 
    } 
    
    vec3 currentCurrTM = ToneMap(currentRGB.rgb);
    vec3 historyHistTM = ToneMap(clearedHistoryRGB);
    vec3 resolvedRGB = ToneMapInvert(mix(currentCurrTM, historyHistTM, feedback)); 
    
    if (isCorrupted(resolvedRGB)) { resolvedRGB = currentRGB.rgb; }
    
    imageStore(globalScreenImages[nonuniformEXT(writeHistoryIdx)], texelCoord, vec4(resolvedRGB, currentRGB.a));
    imageStore(globalScreenImages[nonuniformEXT(CURRENT_COLOR_IDX)], texelCoord, vec4(resolvedRGB, currentRGB.a));
}
