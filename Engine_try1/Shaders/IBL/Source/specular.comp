#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 2) uniform sampler2D skyPanoramaTex;
layout(set = 1, binding = 3, rgba16f) uniform writeonly imageCube iblStorageMaps[];

// Единая структура пуш-констант (ровно 128 байт)
layout(push_constant) uniform PushConstants {
    mat4 render_matrix;
    uvec2 vertexBuffer;  // ИСПРАВЛЕНО: заменено на uvec2 для сохранения размера 8 байт без uint64_t
    uint colorTextureID; // Сюда придут индексы 2, 3, 4, 5 в зависимости от текущего мипа
    uint metallicRoughnessTextureID;
    uint normalTextureID;
    uint occlusionTextureID;
    vec2 padding;
    vec4 baseColorFactor;
    vec4 materialFactors; // В materialFactors.x лежит roughness (от 0.25 до 1.0)
};

const float PI = 3.14159265359;

vec3 GetCubeDirection(vec2 uv, uint face) {
    vec3 dir = vec3(0.0);
    if(face == 0) dir = vec3( 1.0, -uv.y, -uv.x);
    if(face == 1) dir = vec3(-1.0, -uv.y,  uv.x);
    if(face == 2) dir = vec3( uv.x,  1.0, -uv.y);
    if(face == 3) dir = vec3(-uv.x, -1.0, -uv.y);
    if(face == 4) dir = vec3( uv.x, -uv.y,  1.0);
    if(face == 5) dir = vec3( uv.x,  uv.y, -1.0);
    return normalize(dir);
}

vec2 SampleSphericalMap(vec3 v) {
    vec2 uv = vec2(atan(v.y, v.x), asin(v.z));
    uv *= vec2(0.15915494, 0.31830988);
    uv += 0.5;
    uv.y = 1.0 - uv.y;
    return uv;
}

// Радикальная инверсия Ван дер Корпута для генерации выборки Хаммерсли
float RadicalInverse_VdC(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10; 
}

vec2 Hammersley(uint i, uint N) {
    return vec2(float(i)/float(N), RadicalInverse_VdC(i));
}

// Генерируем вектор полупути H на основе важности распределения GGX
vec3 ImportanceSampleGGX(vec2 Xi, vec3 N, float roughness) {
    float a = roughness * roughness;
    
    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a*a - 1.0) * Xi.y));
    float sinTheta = sqrt(1.0 - cosTheta*cosTheta);
    
    // Переход из сферических координат в декартовы тангенциальные
    vec3 H;
    H.x = cos(phi) * sinTheta;
    H.y = sin(phi) * sinTheta;
    H.z = cosTheta;
    
    // Переход в мировые координаты относительно нормали грани куба
    vec3 up        = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 right     = normalize(cross(up, N));
    up            = cross(N, right);
    
    vec3 sampleVec = H.x * right + H.y * up + H.z * N;
    return normalize(sampleVec);
}

void main() {
    ivec3 cubeCoord = ivec3(gl_GlobalInvocationID);
    
    // Драйвер NVIDIA вернет точный размер конкретного мипа, забинденного в дескрипторе!
    ivec2 size = imageSize(iblStorageMaps[colorTextureID]); 
    if (cubeCoord.x >= size.x || cubeCoord.y >= size.y) return;

    vec2 uv = (vec2(cubeCoord.xy) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec3 N = GetCubeDirection(uv, cubeCoord.z);
    
    // Для запекания Specular IBL принимается допущение, что вектор взгляда V равен нормали N
    vec3 V = N;

    float roughness = materialFactors.x;

    const uint SAMPLE_COUNT = 1024u; // Оптимально для качественного запекания на десктопе
    float totalWeight = 0.0;
    vec3 prefilteredColor = vec3(0.0);
    
    for(uint i = 0; i < SAMPLE_COUNT; ++i) {
        vec2 Xi = Hammersley(i, SAMPLE_COUNT);
        vec3 H  = ImportanceSampleGGX(Xi, N, roughness);
        vec3 L  = normalize(2.0 * dot(V, H) * H - V); // Отражаем вектор взгляда относительно полупути

        float NdotL = max(dot(N, L), 0.0);
        if(NdotL > 0.0) {
            vec2 texUV = SampleSphericalMap(L);
            // Интегрируем освещенность с учетом веса угла падения луча
            prefilteredColor += texture(skyPanoramaTex, texUV).rgb * NdotL;
            totalWeight      += NdotL;
        }
    }
    
    prefilteredColor = prefilteredColor / totalWeight;

    imageStore(iblStorageMaps[colorTextureID], cubeCoord, vec4(prefilteredColor, 1.0));
}
