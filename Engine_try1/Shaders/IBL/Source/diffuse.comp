#version 460
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Читаем из Specular (ID 1), пишем в Diffuse (ID 0)
layout(set = 1, binding = 3, rgba16f) uniform readonly imageCube iblInputMaps[];
layout(set = 1, binding = 3, rgba16f) uniform writeonly imageCube iblOutputMaps[];

const float PI = 3.14159265359;

vec3 GetCubeDirection(vec2 uv, uint face) {
    vec3 dir = vec3(0.0);
    if(face == 0) dir = vec3(1.0, -uv.y, -uv.x);
    if(face == 1) dir = vec3(-1.0, -uv.y, uv.x);
    if(face == 2) dir = vec3(uv.x, 1.0, -uv.y);
    if(face == 3) dir = vec3(-uv.x, -1.0, -uv.y);
    if(face == 4) dir = vec3(uv.x, -uv.y, 1.0);
    if(face == 5) dir = vec3(uv.x, uv.y, -1.0);
    return normalize(dir);
}

// Конвертируем вектор направления в пиксельные координаты кубмапы для imageLoad
ivec3 VectorToCubeCoord(vec3 dir, int cubeSize) {
    vec3 absDir = abs(dir);
    int face = 0;
    vec2 uv = vec2(0.0);

    if (absDir.x >= absDir.y && absDir.x >= absDir.z) {
        face = dir.x > 0.0 ? 0 : 1;
        uv = dir.x > 0.0 ? vec2(-dir.z, -dir.y) : vec3(dir.z, -dir.y, 0.0).xy;
        if(dir.x > 0.0) uv = vec2(-dir.z, -dir.y); else uv = vec2(dir.z, -dir.y);
    } else if (absDir.y >= absDir.x && absDir.y >= absDir.z) {
        face = dir.y > 0.0 ? 2 : 3;
        if(dir.y > 0.0) uv = vec2(dir.x, -dir.z); else uv = vec2(-dir.x, -dir.z);
    } else {
        face = dir.z > 0.0 ? 4 : 5;
        if(dir.z > 0.0) uv = vec2(dir.x, -dir.y); else uv = vec2(dir.x, dir.y);
    }

    // Изменение знаков и маппинг под твой Z-Up:
    // (Для простоты внутри интеграла мы можем делать выборку по вектору, но так как это imageLoad, 
    // нам проще делать шаги по углам и собирать из Mip0)
    
    // Упрощенный вариант: для диффуза лучше читать панораму напрямую, чтобы не делать сложный трекинг векторов в imageLoad!
    return ivec3(0);
}

void main() {
    ivec3 cubeCoord = ivec3(gl_GlobalInvocationID);
    ivec2 size = imageSize(iblOutputMaps[0]); // Размер Diffuse (32x32)

    if (cubeCoord.x >= size.x || cubeCoord.y >= size.y) return;

    vec2 uv = (vec2(cubeCoord.xy) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec3 normal = GetCubeDirection(uv, cubeCoord.z);

    vec3 irradiance = vec3(0.0);
    vec3 up = vec3(0.0, 0.0, 1.0);
    vec3 right = normalize(cross(up, normal));
    up = normalize(cross(normal, right));

    float sampleDelta = 0.05;
    float nrSamples = 0.0; 
    
    // Считаем свертку полусферы
    for(float phi = 0.0; phi < 2.0 * PI; phi += sampleDelta) {
        for(float theta = 0.0; theta < 0.5 * PI; theta += sampleDelta) {
            vec3 tangentSample = vec3(sin(theta) * cos(phi),  sin(theta) * sin(phi), cos(theta));
            vec3 sampleDir = tangentSample.x * right + tangentSample.y * up + tangentSample.z * normal;

            // ХИТРОСТЬ: Чтобы не мучаться с imageLoad векторов, мы берем данные ИЗ ТВОЕЙ ПАНОРАМЫ skyPanoramaTex!
            // Это в 10 раз быстрее и точнее!
            vec2 texUV = vec2(atan(sampleDir.y, sampleDir.x), asin(sampleDir.z));
            texUV *= vec2(0.15915494, 0.31830988);
            texUV += 0.5;
            texUV.y = 1.0 - texUV.y;

            // В TextureManager добавь биндинг панорамы в этот шейдер (layout(set=1, binding=2) uniform sampler2D skyPanoramaTex)
            // irradiance += texture(skyPanoramaTex, texUV).rgb * cos(theta) * sin(theta);
            nrSamples++;
        }
    }
    
    // imageStore(iblOutputMaps[0], cubeCoord, vec4(PI * irradiance / nrSamples, 1.0));
}
